{
  "name": "resume-tex",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun scripts/prepare-assets.ts && node node_modules/next/dist/bin/next dev --hostname localhost",
    "build": "bun scripts/prepare-assets.ts && bun --bun next build",
    "start": "node node_modules/next/dist/bin/next start --hostname localhost",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "bun scripts/prepare-assets.ts && bun scripts/prepare-test-assets.ts && bun test tests/unit && vitest run tests/convex.test.ts",
    "test:e2e": "bun scripts/prepare-test-assets.ts && playwright test",
    "setup:tex": "bash scripts/setup-tex.sh",
    "mcp": "bun scripts/mcp.ts",
    "test:mcp:e2e": "bun scripts/prepare-test-assets.ts && playwright test tests/e2e/mcp-editor.spec.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "convex": "^1.49.0",
    "lucide-react": "^1.72.0",
    "next": "16",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.55",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "convex-test": "^0.0.69",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6",
    "vitest": "^5.1.0",
    "@clerk/backend": "3.27.0"
  }
}
